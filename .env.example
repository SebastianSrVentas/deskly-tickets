# Copia este archivo a .env antes de levantar el proyecto:
#   cp .env.example .env
#
# NUNCA versiones el .env real.

# Secreto unico para firmar el webhook (HMAC-SHA256).
# Genera uno con: openssl rand -hex 32
WEBHOOK_SECRET=cambia-este-secreto-de-desarrollo

# Clientes autorizados con secreto propio (JSON). Si esta vacio se usa
# WEBHOOK_SECRET con el cliente "externo".
# Para rotar sin downtime, cada cliente acepta una lista: ["nuevo", "anterior"].
WEBHOOK_CLIENTES=

# Ventana anti-replay del webhook, en segundos.
WEBHOOK_TOLERANCIA_SEGUNDOS=300

# Limite del cuerpo del webhook, en bytes (256 KB).
WEBHOOK_MAX_BODY_BYTES=262144

# Rate limiting: por cliente autenticado y por IP de origen.
RATE_LIMIT_CLIENTE_POR_SEGUNDO=50
RATE_LIMIT_CLIENTE_RAFAGA=50
RATE_LIMIT_IP_POR_SEGUNDO=100
RATE_LIMIT_IP_RAFAGA=100

# Base de datos. Dentro de Docker Compose el host es "mongo";
# este valor es el que usarias al correr el backend fuera de Docker.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=deskly

# Redis. Dentro de Compose el host es "redis".
REDIS_URL=redis://localhost:6379/0

# URL que usa el navegador para llamar al backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: si el WebSocket vive en otro host o usas wss, definelo aqui.
# Si no se define, se deriva de NEXT_PUBLIC_API_URL cambiando http por ws.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Nivel de log: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO

# Siembra 12 tickets de ejemplo cuando la base esta vacia.
# En produccion se apaga con false.
SEED_ON_START=true
